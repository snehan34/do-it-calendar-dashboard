# Create a Supabase project or install Supabase from the Vercel Marketplace.
# Project Settings > API provides both values. The anon key is safe to expose;
# database access is protected by the RLS policies in supabase/schema.sql.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
